{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "glanceeyestrong",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "Play.html"
      },
      "App": {
        "entry": "App.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "glanceeyestrong_dev"
  }
}
